# Serve the Android app file with the right type so phones offer to install it.
AddType application/vnd.android.package-archive .apk
<IfModule mod_headers.c>
  <FilesMatch "\.apk$">
    Header set Content-Disposition "attachment"
    Header set X-Robots-Tag "noindex"
  </FilesMatch>
</IfModule>

# Old direct links to earlier versions get the current one.
RedirectMatch 302 ^/hindu-samrajyam/app/Hindu-Samrajyam-1\.2\.1\.apk$ /hindu-samrajyam/app/Hindu-Samrajyam-1.2.2.apk
