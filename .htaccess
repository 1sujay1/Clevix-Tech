# ==============================================================================
# CLEVIX TECH - CLEAN URLS & APACHE REWRITE RULES
# ==============================================================================
RewriteEngine On
RewriteBase /

# 1. Redirect /index.html directly to root domain /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
RewriteRule ^index\.html$ https://%{HTTP_HOST}/ [R=301,L]

# 2. Redirect any request ending in .html to the clean extensionless URL (301 Permanent)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.html\ HTTP/
RewriteRule ^([^.]+)\.html$ https://%{HTTP_HOST}/ [R=301,L]

# 3. Internally resolve clean extensionless URLs to their .html files
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)/?$ .html [L]

# 4. Custom 404 Error Document
ErrorDocument 404 /404.html
